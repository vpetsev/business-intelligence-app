# Node 26. Copy to .env locally; never commit secrets.
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
# Generate a random value: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_PASSWORD=
# Exact browser origins. Production requires HTTPS except explicit local HTTP mode.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Defaults to true in production, false otherwise. Disable only for local HTTP.
# COOKIE_SECURE=false
# Set the exact number of trusted reverse proxies; zero for direct connections.
TRUST_PROXY_HOPS=0
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_MAX=300
# Global company imports disabled unless a normalized account username is listed.
ADMIN_USERNAMES=
# DATABASE_URL overrides DB_*; production requires DATABASE_URL.
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=bi_app
DB_USER=postgres
DB_PASSWORD=
DB_POOL_MAX=5
# TLS verifies server certificates; optional private CA PEM file.
DB_SSL=false
DB_SSL_CA_FILE=
# Must be an EMPTY disposable PostgreSQL database, never a production database.
TEST_DATABASE_URL=
# Optional DEVELOPMENT/TEST ONLY seed account; never overwrites existing passwords.
DEMO_USERNAME=
DEMO_PASSWORD=
# Optional pre-created read-only guest. No guest enabled by default.
# Guest sessions share the account's saved rows: use only public sample data.
GUEST_USERNAME=
GUEST_PASSWORD=
