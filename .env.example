# Local Docker Compose only. Generate fresh values with:
# node deploy/init-local-env.cjs
POSTGRES_DB=bi_app
POSTGRES_USER=bi_app
POSTGRES_PASSWORD=
JWT_PASSWORD=
WEB_PORT=3000
API_PORT=3001
DB_PORT=5432
# Local HTTP only. Production must use HTTPS and COOKIE_SECURE=true.
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
